# ---------------------------------------------------------------------------
# SafeBite configuration. Copy to .env (never commit .env).
# Every value below is optional: the app runs fully offline with these unset.
# ---------------------------------------------------------------------------

# Local SQLite database (Prisma). Relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Public site URL (used for absolute links in exports and metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI explainer and document extraction -----------------------------------
# DEMO (default): no model is called. Answers come from a fixed template and are labelled as such.
# VERTEX: real Gemini on Vertex AI. Authentication uses Application Default Credentials (ADC),
#         set up with `gcloud auth application-default login`. No access token goes in this file.
SAFEBITE_AI_MODE="DEMO"
# Required when SAFEBITE_AI_MODE=VERTEX. Your Google Cloud project ID (not the project number).
VERTEX_PROJECT_ID=""
VERTEX_LOCATION="us-central1"
# Model name. gemini-2.5-flash is the default; change it here if your project uses another model.
GEMINI_MODEL="gemini-2.5-flash"
# Per-request timeout in milliseconds (1000–60000).
AI_TIMEOUT_MS="15000"
# Optional: path to a service-account key file, only if ADC is not available. Never commit the key.
# GOOGLE_APPLICATION_CREDENTIALS=""

# --- Uploads ----------------------------------------------------------------
# Upload directory (relative to project root). Must stay inside the project.
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_BYTES="5242880"

# --- Demo mode safeguards ---------------------------------------------------
# Moderation & analytics exports are open in development. In production they
# are disabled unless this is explicitly "true" AND an auth layer is in front.
SAFEBITE_ENABLE_DEMO_ADMIN="true"

# --- Rate limits (requests per window, per client IP) -----------------------
RATE_LIMIT_AI_PER_MINUTE="20"
RATE_LIMIT_REPORTS_PER_HOUR="5"
RATE_LIMIT_UPLOADS_PER_HOUR="20"

# --- Analytics / Google Cloud (all optional, all disabled by default) -------
# Analytics export sink: LOCAL (writes JSONL under data/exports) | BIGQUERY
ANALYTICS_SINK="LOCAL"
BIGQUERY_PROJECT_ID=""
BIGQUERY_DATASET="safebite_analytics"
# Override the "as of" date used for freshness calculations (ISO-8601). Defaults to now.
SAFEBITE_AS_OF=""
# Short-lived access token for the BigQuery streaming adapter (server-side only).
BIGQUERY_ACCESS_TOKEN=""
# Salt for hashing client addresses before they are stored with community reports.
SAFEBITE_HASH_SALT="change-me-for-your-deployment"
